DATABASE_URL="postgresql://facturation:facturation@localhost:5432/facturation?schema=public"
PORT=4000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrateur
SEED_ADMIN_EMAIL=admin@facturation.local
SEED_ADMIN_PASSWORD=changeme
NODE_ENV=development
# Comma-separated frontend origins allowed to call the API.
# Example production value: https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

