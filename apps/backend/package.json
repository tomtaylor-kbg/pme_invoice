{
  "name": "@facturation/backend",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "nodemon src/server.js",
    "prestart": "npm run db:generate",
    "start": "node src/server.js",
    "build": "node -e \"console.log('Backend build: no transpilation needed')\"",
    "lint": "node --check src/server.js",
    "test": "node --test src/services/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:demo": "node prisma/seed.js --demo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
