generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  name         String
  email        String    @unique
  role         String    @default("user")
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[] @relation("CreatedBy")
  payments     Payment[] @relation("RecordedPayments")
  cashDisbursements CashDisbursement[] @relation("RecordedCashDisbursements")
  auditLogs     AuditLog[] @relation("AuditLogActor")
}

model Client {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  clientType String    @default("individual")
  status    String    @default("active")
  city      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model WorkspaceSetting {
  id                String   @id @default("singleton")
  companyName       String   @default("Mon entreprise")
  logoDataUrl       String   @default("")
  businessSector    String   @default("Imprimerie")
  vatRate           String   @default("20")
  defaultCurrency   String   @default("EUR")
  addressLine1      String   @default("")
  addressLine2      String   @default("")
  postalCode        String   @default("")
  city              String   @default("")
  country           String   @default("")
  phone             String   @default("")
  phone2            String   @default("")
  email             String   @default("")
  website           String   @default("")
  rccm              String   @default("")
  idNat             String   @default("")
  taxNumber         String   @default("")
  invoicePrefix     String   @default("FAC")
  paymentTermsDays  String   @default("30")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  userId      String?
  status      String        @default("draft")
  currency    String        @default("EUR")
  issueDate   DateTime
  dueDate     DateTime
  total       Decimal       @default(0)
  taxRate     Decimal       @default(20)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     User?         @relation("CreatedBy", fields: [userId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]
}

model InvoiceCounter {
  id              String   @id @default(cuid())
  prefix          String
  year            Int
  currentSequence Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([prefix, year])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  userId    String?
  amount    Decimal
  method    String   @default("cash")
  paidAt    DateTime @default(now())
  reference String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recorder  User?    @relation("RecordedPayments", fields: [userId], references: [id], onDelete: SetNull)
}

model CashDisbursement {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String?
  amount      Decimal
  currency    String   @default("EUR")
  category    String
  beneficiary String
  reason      String
  paidAt      DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recorder    User?    @relation("RecordedCashDisbursements", fields: [userId], references: [id], onDelete: SetNull)
}

model CashDisbursementCounter {
  year            Int      @id
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  actorName   String
  actorEmail  String
  action      String
  entity      String
  description String
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}
